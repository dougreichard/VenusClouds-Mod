# The AIRSHIP ePADD app: the ship's lift, its hold, and its faction's doctrine.
#
# An ePADD app (a //gui/app route + gui_app_register), not a console tab. A tab only shows
# when a mission turns ALLOW_CONSOLE_TABS on, which neither Venus mission did - so the
# first version of this screen existed and nobody could reach it. The PADD is on every
# ship console already, and the tile's badge (lift, doctrine ready) is read WITHOUT
# opening anything. The route's condition hides the tile on a hull that is not Venus.
#
# The screen builds once and then UPDATES its widgets on a revision change - it never
# repaints itself, so a cooldown counting down does not rebuild the screen every second.

default CONSOLE_SELECT = ""   # exists without LegendaryMissions' consoles too

gui_app_register("venus", title="Airship", icon="epadd.status", group="Ship", sort=4,
                 description="Lift, hold and doctrine", status=venus_epadd_badge)


== venus_console_show ==
    gui_tab_back(CONSOLE_SELECT)
    vc_ship = sbs.get_ship_of_client(client_id)
    gui_app_chrome("Airship", venus_console_clean(venus_console_title(vc_ship)))
    gui_section(style="area:4,109px,96,96;")
    gui_row("row-height:2em;")
    vc_lift = gui_text(venus_console_style(vc_ship, "lift"))
    gui_row("row-height:2em;")
    vc_hold = gui_text(venus_console_style(vc_ship, "hold"))
    gui_row("row-height:1em;")
    gui_blank()
    gui_row("row-height:2.4em;")
    vc_name = gui_text(venus_console_style(vc_ship, "ability"))
    gui_row("row-height:2em;")
    vc_desc = gui_text(venus_console_style(vc_ship, "desc"))
    gui_row("row-height:3em;")
    vc_use = gui_button("$text:USE DOCTRINE;")
    gui_row("row-height:2em;")
    vc_said = gui_text("$text: ;color:#8f8;")
    on gui_message(vc_use):
        vc_said.update("$text:" + venus_console_clean(venus_ability_use(vc_ship)) + ";color:#8f8;")
    on change venus_console_revision(vc_ship):
        vc_lift.update(venus_console_style(vc_ship, "lift"))
        vc_hold.update(venus_console_style(vc_ship, "hold"))
        vc_name.update(venus_console_style(vc_ship, "ability"))
    await gui()
    ->END


# At the END of the file: labels fall through, so a route goes after every label.
//gui/app/venus if venus_hull_info(sbs.get_ship_of_client(client_id)) is not None
    jump venus_console_show

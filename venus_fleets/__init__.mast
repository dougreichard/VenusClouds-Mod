# Above the Venusian Clouds - six salvage-airship fleets over the cloud deck of Venus.
#
# 78 airships and stations, 6 point-defense turrets and 11 cloud types, all under their own
# `venus_` keys. Nothing collides with data/shipData.yaml: this ADDS content. The hull file
# lives in the media pack (the engine opens it itself), so a mission lists BOTH this mastlib
# and the pack in story.json.
#
# Everything data-shaped here is GENERATED by _tools/build_mod.py from the art pipeline.
provides venus_fleets
# Optional: LM's hangar (carrier fighters) and consoles (the VENUS tab). Both degrade to nothing.
suggests hangar

import venus_setup.py
import venus_altitude.py
import venus_turrets.py
import venus_missiles.py
import venus_particles.py
import venus_world.py
import venus_abilities.py
import venus_skies.py
import venus_skies.mast
import venus_console.mast


# ---- Factions, rooms, version ---------------------------------------
# Factions are ADDED to PLAYABLE_RACES / NPC_RACES (a pure-Venus game is a mission setting).
# The lift-ring room is registered before any interior is parsed.
venus_registered = venus_register_races()
venus_register_rooms()
set_shared_variable("VENUS_MOD_VERSION", venus_manifest().get("version"))


# ---- Hulls -----------------------------------------------------------
# Unconditional, so a mission can place any one hull without switching a faction on.
# Through add_extra, so sim_create() replays it after create_new_sim() wipes the table.
venus_declared = venus_declare_ships()
print("venus_fleets: " + str(venus_manifest().get("version")) + " hulls " + venus_declared)


# ---- Interiors and ladders (gated by the mission's race settings) ------
venus_interiors_loaded = venus_load_interiors()
venus_ladders_loaded = venus_load_ladders()
set_shared_variable("VENUS_INTERIORS_LOADED", venus_interiors_loaded)
set_shared_variable("VENUS_LADDERS_LOADED", venus_ladders_loaded)
set_shared_variable("VENUS_SKYBOX_COUNT", venus_skybox_resolved())
default shared VENUS_TICKER_ON = False


# ---- Diplomacy ---------------------------------------------------------
# The route LM declares its own sides from. MUST NOT await, and NOT `once`: sim_create()
# re-runs it deliberately.
//shared/signal/create_sides
    venus_sides_doc = amd_document(media_read_relative_file("venus_sides.amd"), data_parser=amd_side_data)
    sides_declare_amd(venus_sides_doc)


# ---- Every Venus hull that spawns: role, lift, smoke, and (hosts) welded turrets ----
//spawn if venus_hull_info(SPAWNED_ID) is not None
    venus_on_spawn(SPAWNED_ID)
    ->END


# ---- Damage costs lift ----------------------------------------------------
//damage/object if venus_hull_info(DAMAGE_TARGET_ID) is not None
    venus_lift_on_damage(to_object(DAMAGE_TARGET_ID), 1)
    ->END


# ---- The world ticker: turrets, clouds, lift. Started once per game. -----
//shared/signal/game_started
    task_schedule(venus_ticker)
    ->END

== venus_ticker ==
    ->END if VENUS_TICKER_ON
    shared VENUS_TICKER_ON = True
    venus_missile_register()
---venus_tick
    await delay_sim(1)
    venus_turrets_tick()
    await delay_sim(1)
    venus_turrets_tick()
    venus_world_tick(2)
    venus_abilities_tick(2)
    venus_wind_tick(2)
    venus_lift_tick(2)
    venus_missiles_tick(2)
    jump venus_tick
